@model Encaixxe.Web.Models.CategoriaViewModel

@{
    ViewData["Title"] = "Editar Categoria";
}

<section class="admin-page py-5">
    <div class="container">
        <div class="admin-header">
            <span class="section-subtitle">Admin</span>
            <h1>Editar Categoria</h1>
            <p>Edite categorias de um Determinado Produto.</p>
        </div>
        <div class="admin-form-card">
    <form method="post" class="row g-3 mt-3">
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="col-md-6">
            <label asp-for="Nome" class="form-label">Nome</label>
            <input asp-for="Nome" class="form-control" />
        </div>

        <div class="col-md-6">
            <label asp-for="Slug" class="form-label">Slug</label>
            <input asp-for="Slug" class="form-control" />
        </div>

        <div class="col-12">
            <button class="btn btn-gold" type="submit">Salvar alterações</button>
            <a class="btn btn-outline-dark" href="/Admin/Categorias">Cancelar</a>
        </div>
    </form>
        </div>
    </div>
</section>