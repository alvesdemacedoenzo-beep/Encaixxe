@model List<Encaixxe.Web.Models.CategoriaViewModel>

@{
    ViewData["Title"] = "Admin - Categorias";
}

<section class="admin-page py-5">
    <div class="container">
        <div class="admin-header d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <span class="section-subtitle">Admin</span>
                <h1>Categorias</h1>
                <p>Gerencie as categorias usadas no catálogo.</p>
            </div>

            <a class="btn btn-gold" href="/Admin/Categorias/Create">
                Nova Categoria
            </a>
        </div>
        <div class="admin-table-card">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Slug</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var categoria in Model)
                {
                    <tr>
                        <td>@categoria.Nome</td>
                        <td>@categoria.Slug</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-dark"
                               href="/Admin/Categorias/Edit/@categoria.Id">
                                Editar
                            </a>

                            <form method="post"
                                  action="/Admin/Categorias/Delete/@categoria.Id"
                                  class="d-inline">
                                <button class="btn btn-sm btn-danger"
                                        onclick="return confirm('Deseja excluir esta categoria?')">
                                    Excluir
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center">
                        Nenhuma categoria encontrada.
                    </td>
                </tr>
            }
        </tbody>
    </table>
        </div>
        <a class="btn btn-outline-dark admin-back-btn"
           href="/Admin">
            ← Voltar ao Painel
        </a>
    </div>
</section>