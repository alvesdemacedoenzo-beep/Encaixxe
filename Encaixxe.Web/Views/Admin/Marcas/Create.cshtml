@model Encaixxe.Web.Models.MarcaViewModel

@{
    ViewData["Title"] = "Nova Marca";
}

<section class="admin-page py-5">
    <div class="container">
        <div class="admin-header">
            <span class="section-subtitle">Admin</span>
            <h1>Nova Marca</h1>
            <p>Cadastre uma nova marca para os produtos.</p>
        </div>
        <div class="admin-form-card">
    <form method="post" class="row g-3 mt-3">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="col-md-6">
            <label asp-for="Nome" class="form-label">Nome</label>
            <input asp-for="Nome" class="form-control" />
        </div>

        <div class="col-12">
            <button class="btn btn-gold" type="submit">Salvar</button>
            <a class="btn btn-outline-dark" href="/Admin/Marcas">Cancelar</a>
        </div>
    </form>
        </div>
    </div>
</section>